@page
@model BugBeading.Pages.Inventory.DetailsModel

@{
    ViewData["Title"] = "Details";
}
<!-- Adjust this to match wireframe -->
<h1>Details</h1>
<div class="container my-5">
    <div class="product-details-card">
        <div class="product-details-image-container">
            @if (!string.IsNullOrWhiteSpace(Model.Product.ImageUrl))
            {
                <img src="@Model.Product.ImageUrl"
                     alt="@Model.Product.Name"
                     class="product-details-image" />
            }
            else
            {
                <div class="product-details-image-placeholder">
                    No image available
                </div>
            }
        </div>
        <div class="product-details-information">
            <div class="product-details-heading">
                <h1>@Model.Product.Name</h1>
                <p class="product-details-price">
                    @Model.Product.Price.ToString("C")
                </p>
            </div>
            <div class="product-details-description">
                <h2>Description</h2>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.Product.Description)
                        ? "No description available."
                        : Model.Product.Description)
                </p>
            </div>
            <div class="product-details-extra">
                <p>
                    <strong>Product Type:</strong>
                    @(Model.Product.ProductType ?? "Not specified")
                </p>
                <p>
                    <strong>Date Added:</strong>
                    @Model.Product.DateAdded.ToString("MMMM d, yyyy")
                </p>
            </div>
            <div class="product-details-actions">
                <a asp-page="./Index"
                   class="btn btn-back-inventory">
                    Back to Inventory
                </a>
            </div>
        </div>
    </div>
</div>