@page
@model ContosoUniversity.Pages.Inventory.IndexModel

@{
    ViewData["Title"] = "Inventory";
}

<div class="inventory-page container my-4">
    <section class="gallery-panel">
        <h1 class="text-center mb-4">Product Inventory</h1>
        <form method="get" asp-page="./Index"
              class="inventory-search mb-3">
            <label for="searchProducts">Search Products:</label>
            <input id="searchProducts"
                   type="text"
                   name="SearchString"
                   value="@Model.CurrentFilter"
                   class="form-control" />
            <button type="submit" class="btn btn-bb">Search</button>
        </form>
        <form method="get" asp-page="./Index"
              class="inventory-sort mb-4">
            <input type="hidden" name="SearchString" value="@Model.CurrentFilter" />
            <span class="fw-semibold">Sort By:</span>
            <label>
                <input type="radio" name="sortOrder" value="Type" checked="@(Model.CurrentSort == "Type")" />
                Type
            </label>
            <label>
                <input type="radio" name="sortOrder"value="Color"checked="@(Model.CurrentSort == "Color")" />
                Color
            </label>
            <label>
                <input type="radio" name="sortOrder" value="Metal" checked="@(Model.CurrentSort == "Metal")" />
                Metal
            </label>
            <label>
                <input type="radio" name="sortOrder" value="Newest" checked="@(Model.CurrentSort == "Newest")" />
                Newest
            </label>
            <button type="submit" class="btn btn-outline-secondary btn-sm">
                Apply
            </button>
        </form>
        <div class="row g-3">
            @foreach (var item in Model.Students)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <a asp-page="./Index"
                       asp-route-selectedProductId="@item.ID"
                       asp-route-SearchString="@Model.CurrentFilter"
                       asp-route-sortOrder="@Model.CurrentSort"
                       class="product-card-link">

                        <article class="product-card">
                            <h2 class="product-card-title">
                                @item.FirstMidName
                            </h2>

                            <p class="product-card-age">
                                @item.Age
                            </p>
                        </article>
                    </a>
                </div>
            }
        </div>
        @if (!Model.Students.Any())
        {
            <p class="text-center py-4">
                No products found.
            </p>
        }
    </section>
</div>