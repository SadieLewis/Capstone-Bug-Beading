@page
@model ContosoUniversity.Pages.Shop.IndexModel

@{
    ViewData["Title"] = "Shopping Cart";
}
<!-- In Index.cshtml.cs add requirement that products must be in the order to be listed here -->
<h1>Shopping Cart</h1>
<table class="table">
    <thead>
        <h3>Items in your cart:</h3>
    </thead>
    <tbody>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Name)
            </th>
            <th>
                 @Html.DisplayNameFor(model => model.Products[0].ProductType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Products[0].Description)
            </th>
        </tr>
    </tbody>
</table>
<!-- Add Checkout Page for this button to navigate to when pressed -->
<button type="button" class="btn btn-success">Proceed to Checkout</button>

