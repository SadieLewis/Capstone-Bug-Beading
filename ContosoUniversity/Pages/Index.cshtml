@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<header class="py-5 bg-image-full" style="background-image: url('https://cdn.pixabay.com/photo/2016/09/29/14/06/background-1702930_1280.jpg')">
        <div class="text-center my-5">
            <img class="img-fluid rounded-circle mb-4" src="https://i.etsystatic.com/67630125/r/isla/4733cc/88498415/isla_100x100.88498415_gvhazb4v.jpg" alt="Bug Beading Logo" />
            <h3 class="text-white fs-3">Bug Beading</h1>
        </div>
</header>
 <section class="py-5">
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <h1>Home</h1>
                <div class="row mb-auto">
                    <p>
                        Handcrafted pieces made with care. 
                    </p>
                    <a class="btn btn-dark my-1" asp-area="" asp-page="/About" role="button">About our Company</a>
                    <a class="btn btn-dark my-1" asp-area="" asp-page="/Inventory/Index" role="button">Browse our Inventory</a>
                    <a class="btn btn-dark my-1" asp-area="" asp-page="/Spotlight/Index" role="button">View our Spotlight Items</a>
                </div>
            </div>
        </div>
    </div>
</section>
<footer class="py-5 bg-image-full" style="background-image: url('https://cdn.pixabay.com/photo/2016/09/29/14/06/background-1702930_1280.jpg')"></footer>