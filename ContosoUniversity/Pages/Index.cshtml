@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<header class="py-5 bg-image-full" style="background-image: url('https://cdn.pixabay.com/photo/2016/09/29/14/06/background-1702930_1280.jpg')">
        <div class="text-center my-5">
            <img class="img-fluid rounded-circle mb-4" src="https://i.etsystatic.com/67630125/r/isla/4733cc/88498415/isla_100x100.88498415_gvhazb4v.jpg" alt="..." />
            <h3 class="text-white fs-3">Bug Beading</h1>
            <a class="btn btn-dark" href="#" role="button">See our collection</a>
        </div>
</header>
 <section class="py-5">
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <h1>Home</h1>
                <div class="row mb-auto">
                    <p>
                        Here is where the Home Page will go, it will have a button to navigate to each page with a short blurb accompanying the page. 
                    </p>
                    <a class="btn btn-dark" href="#" role="button" margin = "10">About our Company</a>
                    <a class="btn btn-dark" href="#" role="button">Browse our Inventory</a>
                     <a class="btn btn-dark" href="#" role="button">View our Spotlight Items</a>
                </div>
            </div>
        </div>
    </div>
    <div class="row no-gutters border mb-4">
        <div class="col p-4 d-flex flex-column position-static">
            <div class="card bg-dark text-white">
                <img class="card-img" src="https://i.etsystatic.com/67630125/r/il/ae4845/8474370476/il_1588xN.8474370476_38be.jpg" alt="Teal and Brown Keychain" width = "500" height = "600">
                <div class="card-img-overlay">
                    <h3 class="card-title">Product Name</h3>
                </div>
            </div>
            <p class="card-text">Product Description.</p>
            <p class="card-text">Price</p>
        </div>
    </div>
    <div class="row no-gutters border mb-4">
        <div class="col p-4 d-flex flex-column position-static">
            <div class="card bg-dark text-white">
                <img class="card-img" src="https://i.etsystatic.com/67630125/r/il/936bab/8522292559/il_1588xN.8522292559_kkrg.jpg" alt="Purple Keychain" width = "500" height = "600">
                <div class="card-img-overlay">
                    <h3 class="card-title">Product Name</h3>
                </div>
            </div>
            <p class="card-text">Product Description.</p>
            <p class="card-text">Price</p>
        </div>
    </div>
    <div class="row no-gutters border mb-4">
        <div class="col p-4 d-flex flex-column position-static">
            <div class="card bg-dark text-white">
                <img class="card-img" src="https://i.etsystatic.com/67630125/r/il/654672/8544205629/il_1588xN.8544205629_761p.jpg" alt="Flower Earrings with single leaf" width = "500" height = "600">
                <div class="card-img-overlay">
                        <h3 class="card-title">Product Name</h3>

                </div>
            </div>
            <p class="card-text">Product Description.</p>
            <p class="card-text">Price</p>
        </div>
    </div> 
</section>

