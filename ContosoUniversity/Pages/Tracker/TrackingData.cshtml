@page
@model BugBeading.Pages.TrackingDataModel

@{
    ViewData["Title"] = "Tracking Data";
}

<div class="container my-5">
    <header class="text-center mb-5">
        <h1>Website Interaction Data</h1>
        <p class="text-muted">
            Monitor visitor engagement throughout Bug Beading.
        </p>
    </header>
    <!-- Interaction Summary -->
    <div class="row g-4 mb-5">
        <div class="col-12 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h2 id="totalInteractions">0</h2>
                    <p class="text-muted mb-0">Total Interactions</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h2 id="totalHovers">0</h2>
                    <p class="text-muted mb-0">Hover Interactions</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h2 id="totalClicks">0</h2>
                    <p class="text-muted mb-0">Clicks</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <h2 id="totalPageTime">0s</h2>
                    <p class="text-muted mb-0">Recorded Page Time</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Interaction Records -->
    <section class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Interaction Records</h2>
            <button type="button"
                    class="btn btn-outline-dark btn-sm"
                    id="refreshData">
                Refresh Data
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Interaction</th>
                            <th>Element</th>
                            <th>Product ID</th>
                            <th>Duration (ms)</th>
                            <th>Page</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody id="interactionTable">
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No interaction data available.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function loadTrackingData() {
                const records = window.BugBeadingTracker
                    ? window.BugBeadingTracker.getRecords()
                    : [];
                const table = document.getElementById("interactionTable");
                let hovers = 0;
                let clicks = 0;
                let pageTime = 0;
                document.getElementById("totalInteractions").textContent =
                    records.length;
                table.innerHTML = "";
                records.forEach(record => {
                    if (record.interactionType.includes("hover")) {
                        hovers++;
                    }
                    if (record.interactionType.includes("click")) {
                        clicks++;
                    }
                    if (record.interactionType === "page_duration") {
                        pageTime += record.durationMilliseconds;
                    }
                    const row = document.createElement("tr");
                    const values = [
                        record.interactionType,
                        record.elementType,
                        record.productId ?? "N/A",
                        record.durationMilliseconds,
                        record.page,
                        new Date(record.timestamp).toLocaleString()
                    ];
                    values.forEach(value => {
                        const cell = document.createElement("td");
                        cell.textContent = value;
                        row.appendChild(cell);
                    });
                    table.appendChild(row);
                });
                if (records.length === 0) {
                    table.innerHTML = `
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted">
                                No interaction data available.
                            </td>
                        </tr>`;
                }
                document.getElementById("totalHovers").textContent = hovers;
                document.getElementById("totalClicks").textContent = clicks
                document.getElementById("totalPageTime").textContent = Math.round(pageTime / 1000) + "s";
            }
            document.getElementById("refreshData").addEventListener("click", loadTrackingData);
            loadTrackingData();
        });
    </script>
}
