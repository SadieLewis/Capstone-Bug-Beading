@page
@model BugBeading.Pages.AboutModel

@{
    ViewData["Title"] = "About Page";
}

<body>
    <div class="container py-5">
        <header class="text-center mb-5">
            <h1>About Us</h1>
        </header>
        <div class="row justify-content-center g-4">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card about-card h-100">
                    <div class="card-body p-4">
                        <h2 class="card-title">About Us</h2>
                        <p class="card-text">
                            We are a small jewelry-making business owned
                            and operated by college student Sadie Lewis.
                            She took her hobby of making jewelry and
                            decided to start Bug Beading as a way to fund
                            making more jewelry.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card about-card h-100">
                    <div class="card-body p-4">
                        <h2 class="card-title">Policies</h2>
                        <p class="card-text">
                            <strong>Returns:</strong> No returns are accepted.
                        </p>
                        <p class="card-text">
                            <strong>Exchanges:</strong> Exchanges are
                            permitted under specific conditions. Please
                            contact us for details if you wish to exchange
                            one of our products.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card about-card h-100">
                    <div class="card-body p-4">
                        <h2 class="card-title">Contact</h2>
                        <p class="card-text">
                            Want to purchase an item from our collection? Contact us using the information below:
                        </p>
                        <p class="card-text">
                            <strong>Email:</strong><br />
                            sadielewis100@gmail.com
                        </p>
                        <p class="card-text">
                            <strong>Etsy:</strong><br />
                            BugBeading on Etsy
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>